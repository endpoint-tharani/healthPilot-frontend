{
  "name": "healthpilot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HealthPilot.ai Multi-Branch Hospital Pharmacy ERP - Frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "npm run smoke:build && node smoke/dist/ssrSmoke.js",
    "smoke:data": "npm run smoke:build && node smoke/dist/dataSmoke.js",
    "smoke:build": "vite build --config smoke/vite.smoke.config.ts --logLevel error"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@tanstack/react-query": "^5.66.9",
    "axios": "^1.8.1",
    "decimal.js": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.30.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
